{
  "$comment": [
    "Default street archetypes for shared-row-parametric. Widths are METRES,",
    "heights CENTIMETRES, per the shared-row specification.",
    "",
    "These are ILLUSTRATIVE STARTING POINTS drawn from widths that appear",
    "commonly in practice, not values adopted from any standard. Every",
    "jurisdiction has its own design criteria: copy this file, edit the",
    "numbers to match your local standards, and pass it with --template-file.",
    "",
    "Travel lanes are numbered from the KERB INWARD, so drive_1 is the",
    "outermost lane on each side. That matches Through_Lane_1 in the",
    "additive schema, verified against all 10 multi-lane segments in",
    "specification/Samples where the lane widths differ.",
    "",
    "'half' is a half section ordered from the OUTSIDE EDGE INWARD; it is",
    "mirrored to build the full left-to-right section, with 'centre' between",
    "the two sides. priority: higher is dropped first. required: never",
    "dropped. flex: relative share of shrink and growth (0 pins the width)."
  ],
  "templates": [
    {
      "name": "local_residential",
      "description": "Low-volume residential street: walkway both sides, kerbside parking, one travel lane per direction.",
      "row_range": [11.0, 18.0],
      "tags": ["local", "residential"],
      "filler": "planting_strip",
      "half": [
        {"type": "sidewalk", "role": "sidewalk", "min_width": 1.5, "preferred_width": 1.8, "max_width": 3.0, "priority": 5, "required": true, "flex": 2.0, "height": 15.24, "meta": {"zone": "through"}},
        {"type": "planting_strip", "role": "furniture", "min_width": 0.6, "preferred_width": 1.2, "max_width": 2.4, "priority": 85, "flex": 1.5, "height": 15.24, "meta": {"zone": "furniture"}},
        {"type": "parking", "role": "parking", "min_width": 2.1, "preferred_width": 2.45, "max_width": 2.6, "priority": 90, "flex": 0.4},
        {"type": "drive_lane", "role": "drive_1", "min_width": 2.7, "preferred_width": 3.0, "max_width": 3.3, "priority": 20, "required": true, "flex": 0.5}
      ]
    },
    {
      "name": "neighborhood_yield",
